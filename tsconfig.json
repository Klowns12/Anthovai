{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // Dead imports accumulated quietly until thirteen of them had built up,
    // including four in one file. `npm run type-check` now refuses them, so
    // the count stays at zero without anyone remembering to look.
    //
    // `noUnusedParameters` is deliberately not enabled: an event handler that
    // ignores its argument is ordinary React, and a rule that fires on correct
    // code teaches people to ignore the rule.
    "noUnusedLocals": true,
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
