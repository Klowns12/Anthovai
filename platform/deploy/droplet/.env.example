# The variables docker-compose.yml expects on the droplet.
#
# The real file lives at /opt/anthovai/.env, mode 600, and is NOT in this
# repository — this repository is public. Generate the secrets on the droplet
# itself so they never pass through a laptop or a terminal history:
#
#   openssl rand -base64 48
#
POSTGRES_PASSWORD=
# The role the application connects as. Not the superuser: PostgreSQL exempts
# superusers from row-level security entirely, which is the whole isolation
# between one customer's knowledge and another's.
APP_DB_PASSWORD=

MINIO_USER=
MINIO_PASSWORD=

# Changing this signs every customer out at the same moment. Generate once.
SESSION_SECRET=

OPENAI_API_KEY=

# Comma-separated. The site's origin must be here or the dashboard gets
# `origin_not_allowed` on every write.
DASHBOARD_ORIGINS=https://www.anthovai.com,https://anthovai.com
# Where confirmation links point, so it must be the public site.
SITE_URL=https://www.anthovai.com

# Without these the platform logs the confirmation link instead of sending it,
# and says so. A live key needs a confirmed address, so until these are set no
# real customer can get one.
# ANTHOVAI__MAIL__SMTP_URL=
# ANTHOVAI__MAIL__USERNAME=
# ANTHOVAI__MAIL__PASSWORD=
# ANTHOVAI__MAIL__FROM=
