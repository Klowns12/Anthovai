# copy to .env for local development
ANTHOVAI__DATABASE__URL=postgres://anthovai:anthovai@localhost:55432/anthovai
# Uncomment to use MinIO instead of local disk:
# ANTHOVAI__STORAGE__PROVIDER=s3
# ANTHOVAI__STORAGE__ENDPOINT=http://localhost:9010
ANTHOVAI__STORAGE__BUCKET=anthovai-dev
ANTHOVAI__STORAGE__ACCESS_KEY=anthovai
ANTHOVAI__STORAGE__SECRET_KEY=anthovai-secret

# Scanned PDFs need the OCR sidecar running next to the worker
# (ocr-sidecar/README.md). Off by default; scans are refused with a reason.
# ANTHOVAI__OCR__ENABLED=true
# ANTHOVAI__OCR__BASE_URL=http://127.0.0.1:9090

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SESSION_SECRET=dev-only-change-me

RUST_LOG=info,anthovai=debug,sqlx=warn
